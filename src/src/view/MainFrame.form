          </component>
          <component id="9ea69" class="javax.swing.JButton" binding="càiĐặtButton" default-binding="true">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Danh mục"/>
            </properties>
          </component>
          <component id="ae63d" class="javax.swing.JButton" binding="đăngXuấtButton" default-binding="true">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Đăng xuất"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="contentScroll">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="contentHolder" binding="contentPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints/>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
