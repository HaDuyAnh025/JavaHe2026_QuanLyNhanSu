<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="view.panels.ListEmployeesPanel">
  <grid id="content" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="12" binding="rootPanel">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="980" height="560"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>

      <!-- ===== Header: doi trang thai giua "Danh sach nhan vien" va "Ket qua tim kiem" bang code =====
           Nut "Loc" va "Xuat" LUON hien thi o trang Quan ly (khong con an theo che do).
           Hang tren: "+ Them nhan vien" / "Xuat". Hang duoi: tieu de (trai), o tim kiem
           nhanh + nut "Tim kiem" + nut "Loc" (phai) - tim kiem chi lien quan trang nay
           nen dat luon o day thay vi thanh tren cua MainFrame. -->
      <grid id="51006" layout-manager="GridLayoutManager" row-count="2" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="4">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="e9ded" class="javax.swing.JLabel" binding="lblPageTitle" default-binding="true">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font style="1" size="20"/>
              <text value="Danh sách nhân viên"/>
            </properties>
          </component>
          <component id="46193" class="javax.swing.JLabel" binding="lblSubtitle" default-binding="true">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Quản lý và theo dõi thông tin nhân sự trong công ty"/>
            </properties>
          </component>
          <hspacer id="hdrSpacer">
            <constraints>
              <grid row="0" column="1" row-span="2" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <component id="29d51" class="javax.swing.JButton" binding="thêmNhânViênButton" default-binding="true">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="+ Thêm nhân viên"/>
            </properties>
          </component>
          <component id="xuatBtn" class="javax.swing.JButton" binding="xuấtButton" default-binding="true">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Xuất"/>
            </properties>
          </component>
          <component id="c66fa" class="javax.swing.JTextField" binding="tìmKiếmNhanhTextField" default-binding="true">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <text value=""/>
              <toolTipText value="Tìm theo tên, số điện thoại, email hoặc mã NV"/>
            </properties>
          </component>
          <component id="f2a91" class="javax.swing.JButton" binding="tìmKiếmButton" default-binding="true">
            <constraints>
              <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Tìm kiếm"/>
            </properties>
          </component>
          <component id="lockBtn" class="javax.swing.JButton" binding="lọcButton" default-binding="true">
            <constraints>
              <grid row="1" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Lọc"/>
            </properties>
          </component>
        </children>
      </grid>

      <!-- ===== Than trang: ben trai la bang loc (an/hien khi bam "Loc"),
           ben phai la bang danh sach / ket qua ===== -->
      <grid id="bodyRow" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="16" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>

          <!-- ===== Bang loc nang cao (mac dinh AN, hien khi bam nut "Loc") ===== -->
          <grid id="filterCard" binding="filterPanel" layout-manager="GridLayoutManager" row-count="9" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="8">
            <margin top="16" left="16" bottom="16" right="16"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="0" anchor="0" fill="2" indent="0" use-parent-layout="false">
                <preferred-size width="240" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <visible value="false"/>
            </properties>
            <border type="line" title="Bộ lọc tìm kiếm"/>
            <children>

              <component id="lblPhongBanF" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Phòng ban"/>
                </properties>
              </component>
              <component id="3fbdc" class="javax.swing.JComboBox" binding="phòngBanComboBox" default-binding="true">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <model>
                    <item value="Tất cả phòng ban"/>
                    <item value="IT"/>
                    <item value="Kinh doanh"/>
                    <item value="Nhân sự"/>
                  </model>
                </properties>
              </component>

              <component id="lblChucVuF" class="javax.swing.JLabel">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Chức vụ"/>
                </properties>
              </component>
              <component id="4661f" class="javax.swing.JComboBox" binding="chứcVụComboBox" default-binding="true">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <model>
                    <item value="Tất cả chức vụ"/>
                    <item value="Nhân viên"/>
                    <item value="Trưởng nhóm"/>
                    <item value="Quản lý"/>
                  </model>
                </properties>
              </component>

              <component id="lblTrangThaiF" class="javax.swing.JLabel">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Trạng thái"/>
                </properties>
              </component>
              <component id="aa553" class="javax.swing.JComboBox" binding="trạngTháiComboBox" default-binding="true">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <model>
                    <item value="Tất cả trạng thái"/>
                    <item value="Đang làm việc"/>
                    <item value="Nghỉ việc"/>
                    <item value="Tạm nghỉ"/>
                  </model>
                </properties>
              </component>

              <component id="lblGioiTinhF" class="javax.swing.JLabel">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Giới tính"/>
                </properties>
              </component>
              <grid id="3db5e" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="d59f0" class="javax.swing.JRadioButton" binding="tấtCảRadioButton" default-binding="true">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <selected value="true"/>
                      <text value="Tất cả"/>
                    </properties>
                  </component>
                  <component id="a9111" class="javax.swing.JRadioButton" binding="namRadioButton" default-binding="true">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Nam"/>
                    </properties>
                  </component>
                  <component id="8c116" class="javax.swing.JRadioButton" binding="nữRadioButton" default-binding="true">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Nữ"/>
                    </properties>
                  </component>
                  <component id="f3a71" class="javax.swing.JRadioButton" binding="khácRadioButton" default-binding="true">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Khác"/>
                    </properties>
                  </component>
                </children>
              </grid>

              <grid id="filterActionsRow" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="true" same-size-vertically="false" hgap="8" vgap="-1">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="applyFilterBtn" class="javax.swing.JButton" binding="ápDụngLọcButton" default-binding="true">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Áp dụng"/>
                    </properties>
                  </component>
                  <component id="clearFilterBtn" class="javax.swing.JButton" binding="xóaLọcButton" default-binding="true">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Xóa lọc"/>
                    </properties>
                  </component>
                </children>
              </grid>

            </children>
          </grid>

          <!-- ===== Bang danh sach / ket qua ===== -->
          <grid id="tableCard" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="8">
            <margin top="8" left="8" bottom="8" right="8"/>
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="line"/>
            <children>

              <scrollpane id="bf90">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="employeeTableComp" class="javax.swing.JTable" binding="employeeTable" default-binding="true">
                    <constraints/>
                    <properties>
                      <rowHeight value="32"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>

        </children>
      </grid>

      <!-- ===== Footer: so luong + phan trang ===== -->
      <grid id="f0e87" layout-manager="GridLayoutManager" row-count="1" column-count="8" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="d04ad" class="javax.swing.JLabel" binding="lblResultCount" default-binding="true">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Hiển thị 1-10 của 150 nhân viên"/>
            </properties>
          </component>
          <hspacer id="6d88a">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <component id="dff23" class="javax.swing.JButton" binding="trangTrướcButton" default-binding="true">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="&lt;"/>
            </properties>
          </component>
          <component id="a1a08" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="1"/>
            </properties>
          </component>
          <component id="15885" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="2"/>
            </properties>
          </component>
          <component id="63fd9" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="3"/>
            </properties>
          </component>
          <component id="5ec92" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="..."/>
            </properties>
          </component>
          <component id="39985" class="javax.swing.JButton" binding="trangSauButton" default-binding="true">
            <constraints>
              <grid row="0" column="7" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="&gt;"/>
            </properties>
          </component>
        </children>
      </grid>

    </children>
  </grid>

  <buttonGroups>
    <group name="genderFilterGroup">
      <members>
        <member id="d59f0"/>
        <member id="a9111"/>
        <member id="8c116"/>
        <member id="f3a71"/>
      </members>
    </group>
  </buttonGroups>
</form>
